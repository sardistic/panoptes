# Broadcastify Calls API — https://www.broadcastify.com/calls/
BROADCASTIFY_API_KEY=
BROADCASTIFY_USERNAME=
BROADCASTIFY_PASSWORD=

# Anthropic
ANTHROPIC_API_KEY=

# Models: heavy extraction vs. cheap high-volume classification
APB_MODEL_HEAVY=claude-opus-4-8
APB_MODEL_LIGHT=claude-haiku-4-5-20251001

# OpenAI alternative for the type learner (used if OPENAI_API_KEY is set; takes
# precedence over Anthropic). Either provider works — it's a JSON mapping task.
OPENAI_API_KEY=
APB_MODEL_OPENAI=gpt-4o-mini

# Google Programmable Search (source discovery via dorks). Free tier 100 queries/day.
# CX = create at programmablesearchengine.google.com (set "search entire web").
# KEY = enable Custom Search API + make a key at console.cloud.google.com.
GOOGLE_API_KEY=
GOOGLE_CX=

# Postgres + PostGIS
APB_DATABASE_URL=postgresql+psycopg://apb:apb@localhost:5432/apb
# Shared snapshots/events/buffers for horizontally scaled web instances. This uses a
# native psycopg DSN (no sqlalchemy driver suffix). Omit for local SQLite state.
# APB_STATE_DATABASE_URL=postgresql://apb:apb@localhost:5432/apb

# Whisper
APB_WHISPER_MODEL=large-v3
APB_WHISPER_DEVICE=cuda          # or cpu
APB_WHISPER_COMPUTE_TYPE=float16 # or int8 for cpu

# Storage
APB_AUDIO_DIR=./data/audio

# ── Keyless live lanes ───────────────────────────────────────────────────────
# All keyless lanes are ON by default (Bluesky firehose, news RSS, Reddit/Mastodon
# RSS, ADS-B aircraft). Set the matching *_OFF flag to 1 to disable a lane.
# APB_BLUESKY_OFF=1      # disable Bluesky/ATProto firehose
# APB_NEWS_OFF=1         # disable news RSS poller
# APB_GNEWS_OFF=1        # disable per-metro Google News incident headlines
# APB_SOCIAL_RSS_OFF=1   # disable Reddit/Mastodon RSS poller
# APB_ADSB_OFF=1         # disable ADS-B aircraft lane (heavy: 14 polls/cycle)
# APB_POLLER_OFF=1       # disable the snapshot/event poller (set on all but one worker)
# Drop the geo requirement on news/social posts (else only metro-centroid placed):
# APB_NEWS_KEEP_UNPLACED=1
# APB_SOCIAL_RSS_KEEP_UNPLACED=1
# APB_BLUESKY_KEEP_UNPLACED=1

# ── Optional keyed lanes (only register when their key is set) ────────────────
FIRMS_MAP_KEY=          # NASA satellite wildfire detections — firms.modaps.eosdis.nasa.gov/api/map_key
AIRNOW_KEY=             # EPA AirNow AQI — docs.airnowapi.org
OPENAQ_KEY=             # OpenAQ air quality — openaq.org
AISSTREAM_KEY=          # maritime AIS firehose — aisstream.io
ACLED_EMAIL=            # civil-unrest events — myACLED login email (acleddata.com/user/register)
ACLED_PASSWORD=         # myACLED account password (OAuth; legacy key+email API is retired)
T511_NE_KEY=            # New England 511 (CT/ME/MA/NH/RI/VT) — newengland511.org
T511_GA_KEY=            # 511ga.org
T511_LA_KEY=            # 511la.org
T511_ID_KEY=            # 511.idaho.gov
T511_PA_KEY=            # 511pa.com
T511_FL_KEY=            # fl511.com

# ── Alerting / persistence ────────────────────────────────────────────────────
# APB_WEBHOOK_URL=       # default alert destination (Discord OK); unset = logged dry run
# APB_ALERT_SCORE=6.0    # global rule when config/alert_rules.json is absent
# APB_ALERT_SOURCES=2    # ...and it needs this many independent source kinds
# APB_ALERT_RULES=config/alert_rules.json   # per-area / per-type rules (see the example)
# APB_OPS_WEBHOOK_URL=   # feed-health changes (falls back to APB_WEBHOOK_URL)
# APB_DIGEST_HOUR_UTC=13 # daily digest hour; unset = no digest
# APB_TASK_SCORE=5.0     # camera tasking: events at/over this score get looked at
# APB_TASK_DAILY=150     # ...with at most this many vision calls a day
# APB_TASKING_OFF=1      # disable camera tasking
# CLOUDFLARE_RADAR_TOKEN=  # Account > Radar: Read only — internet outage lane
# SHODAN_API_KEY=        # only for `python -m apb.discover.shodan_sweep`
# APB_RDIO_PROXY=socks5h://warp-egress:1080   # radio lane egress; lane is off without it
# APB_RDIO_INSTANCES=    # private instance list (default: rdio_instances.json beside the DB)
# APB_RDIO_CAL_PER_MIN=20  # audio requests per source per minute (playback + transcription)
# APB_RADIO_STT_DAILY_SEC=7200  # seconds of radio audio transcribed per day (0 = off)
# APB_RADIO_STT_MIN=0.8  # talkgroup weight needed (1.0 fire/EMS dispatch, 0.85 law dispatch)
# APB_RADIO_STT_OFF=1
# APB_RADIO_FOCUS=<key>:<system>  # hear every talkgroup of these systems (key = instance hash)
# APB_RADIO_AREAS_DAILY=300  # area-summary model calls per day (0 = off)
# APB_RADIO_AREAS_OFF=1
# Road-junction tiles for intersection placement (state/roads.sqlite): off switch, and the
# Overpass mirrors tried in turn (default: APB_OVERPASS_URL, overpass-api.de, private.coffee)
# APB_ROADS_OFF=1
# APB_OVERPASS_URLS=https://overpass.kumi.systems/api/interpreter,https://overpass-api.de/api/interpreter
# APB_DB_PATH=/app/state/apb.sqlite   # history DB location (Railway volume mount)
# APB_RATE_LIMIT=300     # requests/min/IP; 0 disables

# Self-hosted geocoder for the radio/incident pipeline (not needed for the live map).
# APB_NOMINATIM_URL=http://localhost:8080
# APB_PRICE_IN_TEXT=0.30   # cost meter: USD per million input text/image tokens
# APB_PRICE_IN_AUDIO=1.00  # ...per million input audio tokens
# APB_PRICE_OUT=2.50       # ...per million output tokens (thinking included)
